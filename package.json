{
  "name": "mluvitko",
  "version": "1.0.1",
  "description": "Push-to-talk voice input s AI transkripcí",
  "author": "Ondrej",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder --win",
    "build:dir": "electron-builder --win --dir",
    "build:mac": "electron-builder --mac",
    "build:mac:dir": "electron-builder --mac --dir"
  },
  "dependencies": {
    "@jitsi/robotjs": "^0.6.0",
    "electron-updater": "^6.8.3",
    "form-data": "^4.0.0",
    "loudness": "^0.4.2",
    "node-fetch": "^3.3.2",
    "openai": "^6.22.0",
    "screenshot-desktop": "^1.15.3",
    "uiohook-napi": "^1.5.3"
  },
  "devDependencies": {
    "electron": "^40.6.0",
    "electron-builder": "^26.8.1"
  },
  "build": {
    "appId": "com.mluvitko.app",
    "productName": "Mluvitko",
    "copyright": "MIT",
    "mac": {
      "icon": "assets/icon512.png",
      "entitlements": "entitlements.mac.plist",
      "entitlementsInherit": "entitlements.mac.plist",
      "extendInfo": {
        "NSMicrophoneUsageDescription": "Mluvítko potřebuje přístup k mikrofonu pro nahrávání hlasu a přepis řeči na text.",
        "NSAccessibilityUsageDescription": "Mluvítko potřebuje oprávnění pro usnadnění (Accessibility), aby mohlo reagovat na globální klávesové zkratky."
      }
    },
    "win": {
      "icon": "assets/icon.ico"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "ondrejnov",
        "repo": "mluvitko"
      }
    ]
  }
}
