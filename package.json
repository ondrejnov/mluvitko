{
  "name": "mluvitko",
  "version": "1.0.0",
  "description": "Push-to-talk voice input s AI transkripcí",
  "author": "Ondrej",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder --win",
    "build:dir": "electron-builder --win --dir",
    "build:mac": "electron-builder --mac",
    "build:mac:dir": "electron-builder --mac --dir"
  },
  "dependencies": {
    "@jitsi/robotjs": "^0.6.0",
    "electron-updater": "^6.8.3",
    "form-data": "^4.0.0",
    "loudness": "^0.4.2",
    "node-fetch": "^3.3.2",
    "openai": "^6.22.0",
    "screenshot-desktop": "^1.15.3",
    "uiohook-napi": "^1.5.3"
  },
  "devDependencies": {
    "electron": "^28.3.0",
    "electron-builder": "^24.9.1"
  },
  "build": {
    "appId": "com.mluvitko.app",
    "productName": "Mluvítko",
    "copyright": "MIT",
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "assets/icon.ico"
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ],
      "icon": "assets/icon.icns",
      "category": "public.app-category.utilities",
      "entitlements": "entitlements.mac.plist",
      "entitlementsInherit": "entitlements.mac.plist",
      "hardenedRuntime": true
    },
    "dmg": {
      "contents": [
        {
          "x": 130,
          "y": 220
        },
        {
          "x": 410,
          "y": 220,
          "type": "link",
          "path": "/Applications"
        }
      ]
    },
    "nsis": {
      "oneClick": true,
      "runAfterFinish": true
    },
    "files": [
      "main.js",
      "auth.js",
      "overlay.html",
      "recorder.html",
      "settings.html",
      "account.html",
      "assets/**"
    ],
    "extraResources": [],
    "asar": true,
    "publish": [
      {
        "provider": "github",
        "owner": "VASE_GITHUB_JMENO",
        "repo": "VASE_GITHUB_REPOZITAR"
      }
    ]
  }
}
